							"mode": "formdata",
							"formdata": [
								{
									"key": "file",
									"type": "file",
									"src": "/path/to/test.xlsx",
									"description": "Excel file to upload"
								}
							]
						},
						"url": {
							"raw": "{{baseUrl}}/excel/upload",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"excel",
								"upload"
							]
						},
						"description": "Upload a new Excel file to the system"
					},
					"response": []
				}
			],
			"description": "Web UI endpoints for Excel Data Explorer application"
		},
		{
			"name": "Excel API Endpoints",
			"item": [
				{
					"name": "Get Sheet Names",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/excel/sheets/Journal.xlsx",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"excel",
								"sheets",
								"Journal.xlsx"
							]
						},
						"description": "Get names of all sheets in a specific Excel file"
					},
					"response": []
				},
				{
					"name": "Transform - Combine Columns",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/transform/combine?sourceColumns=Column1,Column2&targetColumn=Combined&separator=%20&fileName=transformed.xlsx&includeOriginalColumns=true",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"transform",
								"combine"
							],
							"query": [
								{
									"key": "sourceColumns",
									"value": "Column1,Column2",
									"description": "Source columns to combine (comma-separated)"
								},
								{
									"key": "targetColumn",
									"value": "Combined",
									"description": "Target column name for combined values"
								},
								{
									"key": "separator",
									"value": "%20",
									"description": "Separator for combining values (URL-encoded space)"
								},
								{
									"key": "fileName",
									"value": "transformed.xlsx",
									"description": "Output file name"
								},
								{
									"key": "includeOriginalColumns",
									"value": "true",
									"description": "Whether to include original columns in output"
								}
							]
						},
						"description": "Transform Excel data by combining columns"
					},
					"response": []
				},
				{
					"name": "Download Transformed File",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/transform/download/transformed.xlsx",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"transform",
								"download",
								"transformed.xlsx"
							]
						},
						"description": "Download a transformed Excel file"
					},
					"response": []
				},
				{
					"name": "Get Excel Stats",
					"request": {
						"method": "GET",
						"header": [
