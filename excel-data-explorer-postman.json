								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/stats",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"stats"
							]
						},
						"description": "Get Excel processing statistics"
					},
					"response": []
				}
			],
			"description": "REST API endpoints for Excel Data Explorer application"
